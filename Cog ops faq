### **AAM_Security.yaml**
security:
  - action_id: "APPROVAL_EVENT_FLOW_AUDIT_UC1"
    roles_allowed: [AUDIT_MANAGER, AUDIT_SUPERVISOR, SENIOR_AUDITOR]
    variation_roles:
      expedite_approval:
        additional_roles: [CFO, AUDIT_DIRECTOR]
        requires_dual_approval: true
    abac_filters:
      department: "{user.department}"
      business_unit: "{user.authorized_units}"
      site_code: "{user.primary_site}"
    context_rules:
      status_gate: "audit_status in ['Submitted', 'Under Review']"
      value_threshold: "audit_value <= user.approval_limit"
      conflict_of_interest: "audit_originator != user.employee_id"
    temporal:
      allowed_days: ["MON", "TUE", "WED", "THU", "FRI"]
      blackout_periods: ["month_end_close"]
    approval_requirements:
      standard_approval: { single_approval: true, supervisor_notification: true }
      expedite_approval: { dual_approval: true, supervisor_approval: true }
  - action_id: "ESCALATION_EVENT_FLOW_RISK_UC1"
    roles_allowed: [RISK_ANALYST, RISK_MANAGER, RISK_OFFICER]
    abac_filters:
      risk_category: "{user.authorized_risk_types}"
      portfolio_id: "{user.managed_portfolios}"
    context_rules:
      escalation_threshold: "risk_score >= user.escalation_authority_level"
    approval_requirements:
      threshold_breach: { auto_approved: true }
      manual_escalation: { manager_approval: true, documentation_required: true }
  - action_id: "DETECTION_EVENT_FLOW_FRAUD_UC1"
    roles_allowed: [FRAUD_ANALYST, FRAUD_MANAGER]
    abac_filters:
      customer_segment: "{user.authorized_segments}"
      case_value_range: "{user.min_case_value}-{user.max_case_value}"
    data_privacy:
      mask_fields: [customer_ssn, account_number, customer_email]

