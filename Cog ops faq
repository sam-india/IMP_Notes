### **AAM_Requests.yaml**
requests:
  - action_id: "APPROVAL_EVENT_FLOW_AUDIT_UC1"
    api_requests:
      standard_approval:
        method: "POST"
        endpoint: "/audit/issues/approve"
        body:
          issue_id: "{issue_id}"
          approval_comment: "{approval_comment}"
          reviewer_name: "{reviewer_name}"
      expedite_approval:
        method: "POST"
        endpoint: "/audit/issues/approve"
        body:
          issue_id: "{issue_id}"
          approval_comment: "{approval_comment}"
          expedite_justification: "{expedite_justification}"
    response_patterns:
      success: { status_code: [200, 201], body_status: "approved" }
      validation_failure: { status_code: 400, error_code: "VALIDATION_FAILED" }
      authorization_failure: { status_code: 403, error_code: "INSUFFICIENT_PERMISSIONS" }
  - action_id: "ESCALATION_EVENT_FLOW_RISK_UC1"
    api_requests:
      threshold_breach:
        method: "POST"
        endpoint: "/risk/escalate"
        body:
          risk_id: "{risk_id}"
          escalation_type: "automatic_threshold"
      manual_escalation:
        method: "POST"
        endpoint: "/risk/escalate"
        body:
          risk_id: "{risk_id}"
          escalation_type: "manual_analyst"
    response_patterns:
      success: { status_code: 200 }
      failure: { status_code: 400 }
  - action_id: "DETECTION_EVENT_FLOW_FRAUD_UC1"
    api_requests:
      ai_detected_fraud:
        method: "POST"
        endpoint: "/fraud/cases/create"
        body:
          transaction_id: "{transaction_id}"
          fraud_score: "{fraud_score}"
      customer_reported:
        method: "POST"
        endpoint: "/fraud/cases/create"
        body:
          transaction_id: "{transaction_id}"
          customer_report: "{customer_report}"
    response_patterns:
      success: { status_code: 201 }
      failure: { status_code: 400 }

