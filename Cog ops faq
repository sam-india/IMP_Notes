## ** Agentic Action Manifest.yaml **
## **AAM_Root.yaml**

system_enabled: true                     # Set to false to instantly disable the entire agent and all flows
emergency_disable_reason: ""             # Optionally specify the reason for shutdown
max_global_concurrent_flows: 500         # Max total running agentic flows at once
max_concurrent_users: 1000               # Limit for simultaneous active end users
max_model_cpu_percent: 75                # Model infra safety margin
fallback_mode: manual_only               # Fallback operational mode if AI is degraded
alert_on_catastrophe: true               # Should emergency alerts fire on failure?
last_emergency_disable: 2025-10-08T02:10:23Z
allowed_domains:
  - audit
  - risk
  - fraud
  - ops
global_tags:
  - prod
  - external_integrations_allowed
system_contact: ai-ops-team@yourcompany.com
audit_retention_days: 365
maintenance_window:
  enabled: false
  start_time: ""
  end_time: ""
  message: ""
brand_name: "CogniAiOps"
root_manifest_version: "1.0.0"

## **AAM_Workflows.yaml**

workflows:
  - parent_action: "approve_audit"
    enabled: true
    category: "audit_approval"
    description: "Unified agentic workflow for audit approval, with contextual variations."
    child_actions:
      - action_id: "APPROVAL_EVENT_FLOW_AUDIT"
        enabled: true
        domain: "audit"
        task: "approve_audit_issue"
        description: "Main audit approval workflow supporting standard, expedited, international, and exception scenarios."
        ui_event: "approveButton.click"
        required_fields: [issue_id, reviewer_name]
        variations:
          - variation_id: "standard"
            label: "Standard Approval"
            required_fields: [approval_comment]
            applicability: "Default, all audits"
          - variation_id: "expedite"
            label: "Expedited Approval"
            required_fields: [approval_comment, expedite_reason, supervisor_override]
            applicability: "Urgent flag set by reviewer"
          - variation_id: "international"
            label: "International Approval"
            required_fields: [approval_comment, country_code, regulatory_code]
            applicability: "Audit entity is non-domestic"
          - variation_id: "exception"
            label: "Exception Approval"
            required_fields: [approval_comment, exception_type, supervisor_override]
            applicability: "Exception flagged by supervisor"
        workflow_steps:
          - step: "Load audit data"
            api: "GET /audit/records/{issue_id}"
          - step: "Check reviewer entitlement"
            api: "GET /acl/entitlements/{reviewer_name}/audit"
          - step: "Perform approval"
            api: "POST /audit/issues/approve"
        examples:
          - "Approve audit 12345 (standard)"
          - "Approve audit 12345 (expedite)"
          - "Approve audit INT-22 (international)"
          - "Approve audit 3344 (exception)"

